# ---------------------------------------------------------------------------
# LLM configuration (copy this file to ".env" and fill in your values)
# ---------------------------------------------------------------------------
# The app talks to any OpenAI-COMPATIBLE chat API. Current setup: Requesty
# (an OpenAI-compatible gateway that routes to Anthropic, OpenAI, Meta, etc.).
# Leave the key blank to keep using the built-in mock responses.
#
# Only variables prefixed with VITE_ are exposed to the browser app (Vite rule).
# The build-time scripts (scripts/*.mjs) reuse VITE_LLM_API_KEY via
# `node --env-file=.env`, but never ship to the browser.
# ---------------------------------------------------------------------------

VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://router.requesty.ai/v1

# --- Runtime tiers (browser, live crafting) --------------------------------
# FAST = default for every live call. SMART = the escape hatch you bump a
# single call to. Verify exact model IDs against Requesty's model catalog.
VITE_LLM_MODEL_FAST=anthropic/claude-haiku-4-5
VITE_LLM_MODEL_SMART=anthropic/claude-sonnet-5

# --- Build-time tiers (offline scripts; optional overrides) -----------------
# BUILD_MODEL_CATALOG=anthropic/claude-sonnet-5
# BUILD_MODEL_SPRITES=anthropic/claude-haiku-4-5

# --- Other providers (swap BASE_URL + model IDs) ---------------------------
# Groq:       https://api.groq.com/openai/v1        (llama-3.1-8b-instant)
# OpenRouter: https://openrouter.ai/api/v1          (meta-llama/llama-3.1-8b-instruct)
# OpenAI:     https://api.openai.com/v1             (gpt-4o-mini) — blocks browser CORS

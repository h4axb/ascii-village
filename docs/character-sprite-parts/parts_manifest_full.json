{
  "classification_rules": {
    "cell_size": 20,
    "cell_center_formula": "row = (y - cell_size/2) / cell_size, col = (x - cell_size/2) / cell_size",
    "predicates": {
      "is_neutral_white(r,g,b)": "min(r,g,b) > 195 and max(r,g,b)-min(r,g,b) < 45 and abs(r-b) <= 8",
      "is_denim_blue(r,g,b)": "b > r+15 and b > 110",
      "is_hair_red(r,g,b)": "r > 140 and (r-g) > 90",
      "is_warm_brown(r,g,b)": "40 <= (r-g) <= 90 and 5 <= (g-b) <= 40 and r < 220",
      "is_bag_brown(r,g,b)": "55 <= r <= 195 and g < 130 and b < 110 and (r-b) > 25",
      "is_leg_skin(r,g,b)": "r > 220 and g > 150 and b > 130 and 15 <= (r-b) <= 70"
    },
    "part_rules": {
      "shorts": "is_denim_blue(fill)",
      "hair": "is_hair_red(fill)",
      "eyes": "row in eye_row AND is_warm_brown(fill)",
      "bag": "row >= bag_min_row AND is_bag_brown(fill)",
      "tshirt": "row in shirt_rows AND is_neutral_white(fill)",
      "shoes": "row >= shoe_rows[0] AND is_neutral_white(fill)",
      "leg": "row in leg_rows AND is_leg_skin(fill)"
    },
    "bands": {
      "front": {
        "eye_row": [14, 14],
        "shirt_rows": [17, 20],
        "leg_rows": [21, 22],
        "shoe_rows": [23, 27],
        "bag_min_row": 16
      },
      "side": {
        "eye_row": [13, 13],
        "shirt_rows": [17, 19],
        "leg_rows": [20, 22],
        "shoe_rows": [23, 27],
        "bag_min_row": 16
      }
    }
  },

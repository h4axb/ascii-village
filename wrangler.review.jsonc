// The review Worker: the game alone for a developer, separate from the main
// site (wrangler.jsonc). Built with `npm run build:review` (→ dist-review/),
// deployed with `npx wrangler deploy --config wrangler.review.jsonc`.
// Setup: docs/Review-Deploy.md.
//
// On purpose: no database, no AI key, no secrets, no other bindings; open
// to whoever has the link (worker/review.ts).
{
	"name": "island-preview",
	"main": "worker/review.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist-review",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// the Worker answers /api/* (404) and marks pages noindex
		"run_worker_first": true
	},
	"workers_dev": true,
	"observability": {
		"enabled": false
	}
}

{
  "name": "asciia-bay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:review": "tsc --noEmit && vite build --mode review --outDir dist-review",
    "preview": "vite preview",
    "build:catalog": "node --env-file=.env scripts/build-catalog.mjs",
    "build:sprites": "node --env-file=.env scripts/build-sprites.mjs",
    "build:palm": "node scripts/build-palm.mjs",
    "place:palms": "node scripts/place-palms.mjs",
    "ref": "vite --config tools/glyph-ref/vite.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
